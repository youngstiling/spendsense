# Supabase (from Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Local demo mode (skip login, data in browser). NEVER set true on Vercel.
# NEXT_PUBLIC_DEMO_MODE=true
# DEMO_MODE=true

# Production (Vercel): set both demo flags to false and use real Supabase keys.
# NEXT_PUBLIC_SITE_URL=https://spendsense-wine-five.vercel.app

# Temporary: open app without magic link (set on Vercel to share without login)
# NEXT_PUBLIC_AUTH_DISABLED=true
# See VERCEL-DEPLOY.md

# Optional: GPT insight narratives (server-only, never NEXT_PUBLIC_)
# OPENAI_API_KEY=sk-...
